# Database
DATABASE_URL="postgresql://user:password@localhost:5432/freelancer_hub?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# App
# Base URL used to build verification links (defaults to NEXTAUTH_URL)
APP_URL="http://localhost:3000"

# SMTP (Nodemailer) — Gmail setup.
# Use a Gmail App Password (Google Account > Security > 2-Step Verification >
# App passwords). For other providers, change SMTP_HOST/PORT/SECURE accordingly.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="YOUR_EMAIL@gmail.com"
SMTP_PASS="YOUR_APP_PASSWORD"
MAIL_FROM="Freelancer Hub <YOUR_EMAIL@gmail.com>"
