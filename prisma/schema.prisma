generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  fullName      String?
  firstName     String?
  middleName    String?   // joins extra names when full name has more than 3 words
  lastName      String?
  passwordHash  String?   // null if OAuth-only account
  emailVerified DateTime?
  oauthProvider String?   // e.g. "google"
  oauthId       String?
  deactivatedAt DateTime? // grace period start
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String   // email address
  token      String   @unique
  type       String   // "email_verification" or "password_reset"
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([identifier, type])
}

model AccountRequest {
  id             String    @id @default(cuid())
  idempotencyKey String    @unique
  email          String
  status         String    @default("PENDING") // PENDING | COMPLETED
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([email])
}

model LoginAttempt {
  id          String    @id @default(cuid())
  email       String
  ip          String
  failures    Int       @default(0)
  lockedUntil DateTime?
  lastAttempt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([email, ip])
  @@index([email])
  @@index([ip])
}
